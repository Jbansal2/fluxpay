*----------------------------------------------------------------------
* MAPSET CBMNMS - MAIN MENU
* GENERATED BY genmaps.py (EDIT THERE). ASSEMBLE WITH DFHMAPS.
* UNTESTED: NO CICS IN THIS ENVIRONMENT - SEE cics/README.md.
*----------------------------------------------------------------------
CBMNMS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               CTRL=(FREEKB,FRSET),TIOAPFX=YES
CBMNMAP  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=8,ATTRB=(ASKIP,BRT),INITIAL='COREBANK'
         DFHMDF POS=(1,30),LENGTH=9,ATTRB=(ASKIP,BRT),                 X
               INITIAL='MAIN MENU'
TRNDATE  DFHMDF POS=(1,70),LENGTH=10,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(5,20),LENGTH=18,ATTRB=(ASKIP,NORM),               X
               INITIAL='1. ACCOUNT INQUIRY'
         DFHMDF POS=(6,20),LENGTH=16,ATTRB=(ASKIP,NORM),               X
               INITIAL='2. FUND TRANSFER'
         DFHMDF POS=(8,20),LENGTH=8,ATTRB=(ASKIP,NORM),                X
               INITIAL='OPTION :'
OPTION   DFHMDF POS=(8,29),LENGTH=1,ATTRB=(UNPROT,IC,FSET)
         DFHMDF POS=(8,31),LENGTH=1,ATTRB=(ASKIP),INITIAL=' '
USERNM   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(ASKIP,NORM)
MSG      DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=34,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTER=PROCESS PF3=EXIT PF5=REFRESH'
         DFHMSD TYPE=FINAL
         END
