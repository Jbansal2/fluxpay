         DFHMDF POS=(1,1),LENGTH=8,ATTRB=(ASKIP,BRT),INITIAL='COREBANK'
         DFHMDF POS=(1,30),LENGTH=13,ATTRB=(ASKIP,BRT),                X
               INITIAL='FUND TRANSFER'
TRNDATE  DFHMDF POS=(1,70),LENGTH=10,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(3,1),LENGTH=14,ATTRB=(ASKIP,NORM),                X
               INITIAL='FROM ACCOUNT :'
FROMAC   DFHMDF POS=(3,16),LENGTH=10,ATTRB=(UNPROT,NUM,IC,FSET)
         DFHMDF POS=(3,27),LENGTH=1,ATTRB=(ASKIP),INITIAL=' '
         DFHMDF POS=(5,1),LENGTH=14,ATTRB=(ASKIP,NORM),                X
               INITIAL='TO ACCOUNT   :'
TOAC     DFHMDF POS=(5,16),LENGTH=10,ATTRB=(UNPROT,NUM,FSET)
         DFHMDF POS=(5,27),LENGTH=1,ATTRB=(ASKIP),INITIAL=' '
         DFHMDF POS=(7,1),LENGTH=14,ATTRB=(ASKIP,NORM),                X
               INITIAL='AMOUNT       :'
AMOUNT   DFHMDF POS=(7,16),LENGTH=13,ATTRB=(UNPROT,FSET)
         DFHMDF POS=(7,30),LENGTH=1,ATTRB=(ASKIP),INITIAL=' '
         DFHMDF POS=(9,1),LENGTH=14,ATTRB=(ASKIP,NORM),                X
               INITIAL='NARRATION    :'
NARR     DFHMDF POS=(9,16),LENGTH=30,ATTRB=(UNPROT,FSET)
         DFHMDF POS=(9,47),LENGTH=1,ATTRB=(ASKIP),INITIAL=' '
FROMNM   DFHMDF POS=(4,16),LENGTH=40,ATTRB=(ASKIP,NORM)
TONM     DFHMDF POS=(6,16),LENGTH=40,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(12,1),LENGTH=14,ATTRB=(ASKIP,NORM),               X
               INITIAL='CONFIRM (Y/N):'
CONFIRM  DFHMDF POS=(12,16),LENGTH=1,ATTRB=(UNPROT,FSET)
         DFHMDF POS=(12,18),LENGTH=1,ATTRB=(ASKIP),INITIAL=' '
MSG      DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=34,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTER=PROCESS PF3=EXIT PF5=REFRESH'
         DFHMSD TYPE=FINAL
