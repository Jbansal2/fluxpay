*----------------------------------------------------------------------
* MAPSET CBAIMS - ACCOUNT INQUIRY
* GENERATED BY genmaps.py (EDIT THERE). ASSEMBLE WITH DFHMAPS.
* UNTESTED: NO CICS IN THIS ENVIRONMENT - SEE cics/README.md.
*----------------------------------------------------------------------
CBAIMS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               CTRL=(FREEKB,FRSET),TIOAPFX=YES
CBAIMAP  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=8,ATTRB=(ASKIP,BRT),INITIAL='COREBANK'
         DFHMDF POS=(1,30),LENGTH=15,ATTRB=(ASKIP,BRT),                X
               INITIAL='ACCOUNT INQUIRY'
TRNDATE  DFHMDF POS=(1,70),LENGTH=10,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(3,1),LENGTH=12,ATTRB=(ASKIP,NORM),                X
               INITIAL='ACCOUNT NO :'
ACCTNO   DFHMDF POS=(3,14),LENGTH=10,ATTRB=(UNPROT,NUM,IC,FSET)
         DFHMDF POS=(3,25),LENGTH=1,ATTRB=(ASKIP),INITIAL=' '
         DFHMDF POS=(5,1),LENGTH=12,ATTRB=(ASKIP,NORM),                X
               INITIAL='NAME       :'
NAME     DFHMDF POS=(5,14),LENGTH=40,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(6,1),LENGTH=12,ATTRB=(ASKIP,NORM),                X
               INITIAL='TYPE       :'
ACTYPE   DFHMDF POS=(6,14),LENGTH=10,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(7,1),LENGTH=12,ATTRB=(ASKIP,NORM),                X
               INITIAL='STATUS     :'
STATUS   DFHMDF POS=(7,14),LENGTH=10,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(8,1),LENGTH=12,ATTRB=(ASKIP,NORM),                X
               INITIAL='BRANCH     :'
BRANCH   DFHMDF POS=(8,14),LENGTH=6,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(9,1),LENGTH=12,ATTRB=(ASKIP,NORM),                X
               INITIAL='BALANCE    :'
BAL      DFHMDF POS=(9,14),LENGTH=20,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(10,1),LENGTH=12,ATTRB=(ASKIP,NORM),               X
               INITIAL='AVAILABLE  :'
AVAIL    DFHMDF POS=(10,14),LENGTH=20,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(11,1),LENGTH=12,ATTRB=(ASKIP,NORM),               X
               INITIAL='LAST TXN   :'
LASTTXN  DFHMDF POS=(11,14),LENGTH=10,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(13,1),LENGTH=19,ATTRB=(ASKIP,BRT),                X
               INITIAL='RECENT TRANSACTIONS'
TXN1     DFHMDF POS=(14,1),LENGTH=78,ATTRB=(ASKIP,NORM)
TXN2     DFHMDF POS=(15,1),LENGTH=78,ATTRB=(ASKIP,NORM)
TXN3     DFHMDF POS=(16,1),LENGTH=78,ATTRB=(ASKIP,NORM)
TXN4     DFHMDF POS=(17,1),LENGTH=78,ATTRB=(ASKIP,NORM)
TXN5     DFHMDF POS=(18,1),LENGTH=78,ATTRB=(ASKIP,NORM)
MSG      DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=34,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTER=PROCESS PF3=EXIT PF5=REFRESH'
         DFHMSD TYPE=FINAL
         END
