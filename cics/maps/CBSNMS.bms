*----------------------------------------------------------------------
* MAPSET CBSNMS - SIGN ON
* GENERATED BY genmaps.py (EDIT THERE). ASSEMBLE WITH DFHMAPS.
* UNTESTED: NO CICS IN THIS ENVIRONMENT - SEE cics/README.md.
*----------------------------------------------------------------------
CBSNMS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               CTRL=(FREEKB,FRSET),TIOAPFX=YES
CBSNMAP  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=8,ATTRB=(ASKIP,BRT),INITIAL='COREBANK'
         DFHMDF POS=(1,30),LENGTH=7,ATTRB=(ASKIP,BRT),INITIAL='SIGN ON'
TRNDATE  DFHMDF POS=(1,70),LENGTH=10,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(6,20),LENGTH=10,ATTRB=(ASKIP,NORM),               X
               INITIAL='USER ID  :'
USERID   DFHMDF POS=(6,31),LENGTH=8,ATTRB=(UNPROT,IC,FSET)
         DFHMDF POS=(6,40),LENGTH=1,ATTRB=(ASKIP),INITIAL=' '
         DFHMDF POS=(8,20),LENGTH=10,ATTRB=(ASKIP,NORM),               X
               INITIAL='PASSWORD :'
PASSWD   DFHMDF POS=(8,31),LENGTH=8,ATTRB=(UNPROT,DRK)
         DFHMDF POS=(8,40),LENGTH=1,ATTRB=(ASKIP),INITIAL=' '
MSG      DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=34,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTER=PROCESS PF3=EXIT PF5=REFRESH'
         DFHMSD TYPE=FINAL
         END
