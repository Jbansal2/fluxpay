//CBCICSF  JOB (CBANK),'COREBANK CICS FILES',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*----------------------------------------------------------------*
//* COREBANK - TRANSACTION LOG AS AN ESDS FOR THE CICS PROGRAMS,   *
//* WITH AN ALTERNATE INDEX ON THE ACCOUNT NUMBER (BYTES 13-22,    *
//* OFFSET 12, LENGTH 10) SO CBINQ CAN SHOW RECENT TRANSACTIONS.   *
//* THE AIX IS UPGRADE-SET, SO CICS WRITES KEEP IT CURRENT.        *
//* UNTESTED - NO z/OS IN THIS ENVIRONMENT.                        *
//*----------------------------------------------------------------*
//DEFINE   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE CBANK.PROD.TRANLOG.ESDS CLUSTER PURGE
  SET MAXCC = 0
  DEFINE CLUSTER (NAME(CBANK.PROD.TRANLOG.ESDS) -
         NONINDEXED RECORDSIZE(106 106) -
         RECORDS(500000 100000) SHAREOPTIONS(2 3)) -
         DATA (NAME(CBANK.PROD.TRANLOG.ESDS.DATA))
  DEFINE AIX (NAME(CBANK.PROD.TRANLOG.AIX) -
         RELATE(CBANK.PROD.TRANLOG.ESDS) -
         KEYS(10 12) NONUNIQUEKEY UPGRADE -
         RECORDSIZE(24 4000) RECORDS(50000 10000)) -
         DATA  (NAME(CBANK.PROD.TRANLOG.AIX.DATA)) -
         INDEX (NAME(CBANK.PROD.TRANLOG.AIX.INDEX))
  DEFINE PATH (NAME(CBANK.PROD.TRANLOG.PATH) -
         PATHENTRY(CBANK.PROD.TRANLOG.AIX) UPDATE)
/*
//*----------------------------------------------------------------*
//* LOAD THE BATCH JOURNAL INTO THE ESDS, THEN BUILD THE AIX       *
//*----------------------------------------------------------------*
//LOAD     EXEC PGM=IDCAMS,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SEQIN    DD DSN=CBANK.PROD.TRANLOG,DISP=SHR
//ESDS     DD DSN=CBANK.PROD.TRANLOG.ESDS,DISP=OLD
//SYSIN    DD *
  REPRO INFILE(SEQIN) OUTFILE(ESDS)
  BLDINDEX INDATASET(CBANK.PROD.TRANLOG.ESDS) -
           OUTDATASET(CBANK.PROD.TRANLOG.AIX)
/*
