//CBMONTH  JOB (CBANK),'COREBANK MONTH END',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*----------------------------------------------------------------*
//* COREBANK - MONTH END. SAME STEPS AS jobs/MONTHEND.sh.          *
//* RUN AFTER THE LAST EOD OF THE MONTH HAS ENDED WITH RC <= 4.    *
//*----------------------------------------------------------------*
//         JCLLIB ORDER=CBANK.PROD.PROCLIB
//*
//* STEP010 - SAVINGS INTEREST (DAILY PRODUCT) AND OD INTEREST
//STEP010  EXEC CBPGM,PGM=INTCALC
//RUN.SYSIN DD *

/*
//* STEP020 - MONTHLY CHARGES (MIN BALANCE, SMS, LOCKER RENT)
//STEP020  EXEC CBPGM,PGM=CHGBATCH,COND=(4,LT)
//RUN.SYSIN DD *

/*
//* STEP030 - AML MONTHLY REPORT (CTR / STR CANDIDATES)
//STEP030  EXEC CBPGM,PGM=AMLRPT,COND=(4,LT)
//RUN.SYSIN DD *

/*
//* STEP040 - TDS REPORT
//STEP040  EXEC CBPGM,PGM=TDSRPT,COND=(4,LT)
//RUN.SYSIN DD *


/*
//* STEP050 - MASTER VS TRANSACTION LOG
//STEP050  EXEC CBPGM,PGM=DATAUTIL,COND=(4,LT)
//RUN.SYSIN DD *
4
/*
//* STEP060 - TRIAL BALANCE AFTER INTEREST AND CHARGES
//STEP060  EXEC CBPGM,PGM=GLRPT,COND=(4,LT)
//*
//* STEP070 - ACCOUNT EXTRACT (CSV) FOR THE REGULATORY RETURN
//STEP070  EXEC CBPGM,PGM=DATAUTIL,COND=(4,LT)
//RUN.SYSIN DD *
1
/*
//* STEP075 - CREDIT BUREAU FILE (RC 4 = INCOMPLETE BORROWER KYC)
//STEP075  EXEC CBPGM,PGM=CIBILOUT,COND=(4,LT)
//RUN.SYSIN DD *

/*
//* STEP077 - REGULATORY RETURNS (RC 4 = LIQUIDITY GAP BREACH)
//STEP077  EXEC CBPGM,PGM=REGRPT,COND=(4,LT)
//RUN.SYSIN DD *

/*
//* STEP078 - IRAC PROVISIONING AND ACCRUAL
//STEP078  EXEC CBPGM,PGM=PROVBAT,COND=(4,LT)
//RUN.SYSIN DD *

/*
//* STEP079 - CUSTOMER STATEMENTS (SORT)
//STEP079  EXEC CBPGM,PGM=STMTBAT,COND=(4,LT)
//RUN.SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(20,10))
//RUN.SYSIN DD *

/*
//* STEP080 - SQL MANAGEMENT REPORTS ON THE REPORTING DATABASE
//STEP080  EXEC CBPGM,PGM=SQLRPT,COND=(4,LT)
//*
//* STEP090 - KEEP A MONTH-END GENERATION OF THE TRANSACTION LOG
//STEP090  EXEC PGM=IEBGENER,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=CBANK.PROD.TRANLOG,DISP=SHR
//SYSUT2   DD DSN=CBANK.HIST.TRANLOG(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(50,25),RLSE),
//            DCB=(RECFM=FB,LRECL=106,BLKSIZE=0)
