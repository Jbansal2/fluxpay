//CBEOD    JOB (CBANK),'COREBANK EOD',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*----------------------------------------------------------------*
//* COREBANK - END OF DAY. SAME STEPS AS jobs/EODJOB.sh.           *
//* RC 4 IS A WARNING (RETURNS, RETRIES) AND THE JOB CARRIES ON;   *
//* RC 8 OR MORE STOPS EVERYTHING AFTER IT VIA COND=(4,LT).        *
//*----------------------------------------------------------------*
//         JCLLIB ORDER=CBANK.PROD.PROCLIB
//*
//* STEP005 - BACK UP THE ACCOUNT MASTER BEFORE ANY UPDATE
//STEP005  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//BACKUP   DD DSN=CBANK.BKUP.ACCTMAST(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(10,5),RLSE),
//            DCB=(RECFM=FB,LRECL=156,BLKSIZE=0)
//SYSIN    DD *
  REPRO INFILE(MASTER) OUTFILE(BACKUP)
/*
//MASTER   DD DSN=CBANK.PROD.ACCTMAST.KSDS,DISP=SHR
//*
//* STEP010 - CONTROL TOTALS BEFORE THE RUN
//STEP010  EXEC CBPGM,PGM=DATAUTIL,COND=(4,LT)
//RUN.SYSIN DD *
3
/*
//* STEP020 - INWARD CHEQUE CLEARING (RC 4 = SOME RETURNED)
//STEP020  EXEC CBPGM,PGM=CLRBATCH,COND=(4,LT)
//RUN.CLRIN DD DSN=CBANK.PROD.CLRIN,DISP=(OLD,DELETE,KEEP)
//RUN.SYSIN DD *

/*
//* STEP030 - NEFT/RTGS SETTLEMENT, RETURNS, INWARD CREDITS
//STEP030  EXEC CBPGM,PGM=PAYBATCH,COND=(4,LT)
//RUN.SYSIN DD *

/*
//* STEP035 - INWARD NACH DEBITS (RC 4 = SOME RETURNED)
//STEP035  EXEC CBPGM,PGM=NACHBAT,COND=(4,LT)
//RUN.NACHIN DD DSN=CBANK.PROD.NACHIN,DISP=(OLD,DELETE,KEEP)
//RUN.SYSIN DD *

/*
//* STEP036 - OUTWARD CHEQUE RETURNS AND DEEMED-CLEARED CREDITS
//STEP036  EXEC CBPGM,PGM=CTSRET,COND=(4,LT)
//RUN.CTSRESP DD DSN=CBANK.PROD.CTSRESP,DISP=(OLD,DELETE,KEEP)
//RUN.SYSIN DD *

/*
//* STEP037 - OUTWARD CHEQUE PRESENTATION FILE
//STEP037  EXEC CBPGM,PGM=CTSOUT,COND=(4,LT)
//RUN.SYSIN DD *

/*
//* STEP040 - STANDING INSTRUCTIONS DUE TODAY
//STEP040  EXEC CBPGM,PGM=SIBATCH,COND=(4,LT)
//RUN.SYSIN DD *

/*
//* STEP050 - EOD: PRODUCTS, DORMANCY, LOANS, DEPOSITS, CARDS
//STEP050  EXEC CBPGM,PGM=EODBATCH,COND=(4,LT)
//RUN.SYSIN DD *

/*
//* STEP052 - RESET REPO-LINKED LOANS (RC 4 = EMI RAISED)
//STEP052  EXEC CBPGM,PGM=LNRESET,COND=(4,LT)
//RUN.SYSIN DD *

/*
//* STEP055 - CREDIT CARDS: AUTOPAY, LATE FEES, STATEMENTS
//STEP055  EXEC CBPGM,PGM=CCBATCH,COND=(4,LT)
//RUN.SYSIN DD *

/*
//* STEP058 - GOLD LOAN REVALUATION AND MARGIN CALLS
//STEP058  EXEC CBPGM,PGM=GOLDREVL,COND=(4,LT)
//RUN.SYSIN DD *

/*
//* STEP058A - TRADE FINANCE EXPIRY AND CONTINGENT REGISTER
//STEP058A EXEC CBPGM,PGM=TFBATCH,COND=(4,LT)
//RUN.SYSIN DD *

/*
//* STEP059 - BRANCH CASH POSITION (RC 4 = OPEN/SHORT DRAWERS)
//STEP059  EXEC CBPGM,PGM=CASHRPT,COND=(4,LT)
//RUN.SYSIN DD *

/*
//* STEP060 - MASTER VS TRANSACTION LOG (RC 8 = MISMATCH)
//STEP060  EXEC CBPGM,PGM=DATAUTIL,COND=(4,LT)
//RUN.SYSIN DD *
4
/*
//* STEP070 - TRIAL BALANCE + SUB-LEDGER RECONCILIATION
//STEP070  EXEC CBPGM,PGM=GLRPT,COND=(4,LT)
//*
//* STEP080 - SORT TODAY'S JOURNAL BY ACCOUNT FOR THE BRANCH PRINT
//* TRAN-ACCT-NO STARTS IN BYTE 13 (AFTER THE 12-BYTE TRAN-ID)
//STEP080  EXEC PGM=SORT,COND=(4,LT)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=CBANK.PROD.TRANLOG,DISP=SHR
//SORTOUT  DD DSN=&&TRANSRT,DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(CYL,(10,5),RLSE)
//SYSIN    DD *
  SORT FIELDS=(13,10,ZD,A,1,12,ZD,A)
/*
//* STEP075 - FRAUD RULES (RC 4 = NEW ALERTS)
//STEP075  EXEC CBPGM,PGM=FRAUDBAT,COND=(4,LT)
//RUN.SYSIN DD *

/*
//* STEP076 - COLLECTIONS REMINDERS
//STEP076  EXEC CBPGM,PGM=COLLBAT,COND=(4,LT)
//RUN.SYSIN DD *

/*
//* STEP090 - MIS REPORTS
//STEP090  EXEC CBPGM,PGM=MISRPT,COND=(4,LT)
//RUN.SYSIN DD *
A
/*
//* STEP100 - OPTIONAL FEED TO THE REPORTING DATABASE
//STEP100  EXEC CBPGM,PGM=SQLLOAD,COND=(4,LT)
