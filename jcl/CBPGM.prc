//CBPGM    PROC PGM=,LOADLIB='CBANK.PROD.LOADLIB'
//*----------------------------------------------------------------*
//* COREBANK - RUN ONE BATCH PROGRAM THROUGH RUNPGM                *
//*   RUNPGM CHECKS THE PROGRAM AGAINST ITS ALLOWED LIST, WRITES   *
//*   THE START/END AUDIT RECORDS AND PASSES THE RETURN CODE BACK  *
//*   AS THE STEP CONDITION CODE.                                  *
//*   ANY RUN PARAMETERS GO IN AN IN-STREAM //STEP.SYSIN DD,       *
//*   ONE VALUE PER LINE (THE PROGRAMS READ THEM WITH ACCEPT).     *
//*----------------------------------------------------------------*
//RUN      EXEC PGM=RUNPGM,PARM='&PGM'
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//ACCTMAST DD DSN=CBANK.PROD.ACCTMAST.KSDS,DISP=SHR
//CUSTMAST DD DSN=CBANK.PROD.CUSTMAST.KSDS,DISP=SHR
//ACCTREL  DD DSN=CBANK.PROD.ACCTREL.KSDS,DISP=SHR
//LOANMAST DD DSN=CBANK.PROD.LOANMAST.KSDS,DISP=SHR
//DEPMAST  DD DSN=CBANK.PROD.DEPMAST.KSDS,DISP=SHR
//CARDMAST DD DSN=CBANK.PROD.CARDMAST.KSDS,DISP=SHR
//CCMAST   DD DSN=CBANK.PROD.CCMAST.KSDS,DISP=SHR
//CHQREG   DD DSN=CBANK.PROD.CHQREG.KSDS,DISP=SHR
//CHGLOG   DD DSN=CBANK.PROD.CHGLOG.KSDS,DISP=SHR
//GLMAST   DD DSN=CBANK.PROD.GLMAST.KSDS,DISP=SHR
//LOCKMAST DD DSN=CBANK.PROD.LOCKMAST.KSDS,DISP=SHR
//PAYREG   DD DSN=CBANK.PROD.PAYREG.KSDS,DISP=SHR
//SIMAST   DD DSN=CBANK.PROD.SIMAST.KSDS,DISP=SHR
//USERMAST DD DSN=CBANK.PROD.USERMAST.KSDS,DISP=SHR
//AMLDAY   DD DSN=CBANK.PROD.AMLDAY.KSDS,DISP=SHR
//RATEMAST DD DSN=CBANK.PROD.RATEMAST.KSDS,DISP=SHR
//PENDTXN  DD DSN=CBANK.PROD.PENDTXN.KSDS,DISP=SHR
//CASHPOS  DD DSN=CBANK.PROD.CASHPOS.KSDS,DISP=SHR
//MANDMAST DD DSN=CBANK.PROD.MANDMAST.KSDS,DISP=SHR
//OUTCHQ   DD DSN=CBANK.PROD.OUTCHQ.KSDS,DISP=SHR
//CHKPOINT DD DSN=CBANK.PROD.CHKPOINT.KSDS,DISP=SHR
//LOANAPP  DD DSN=CBANK.PROD.LOANAPP.KSDS,DISP=SHR
//FRAUDALT DD DSN=CBANK.PROD.FRAUDALT.KSDS,DISP=SHR
//TFMAST   DD DSN=CBANK.PROD.TFMAST.KSDS,DISP=SHR
//FXRATE   DD DSN=CBANK.PROD.FXRATE.KSDS,DISP=SHR
//FDRATE   DD DSN=CBANK.PROD.FDRATE.KSDS,DISP=SHR
//SWPMAST  DD DSN=CBANK.PROD.SWPMAST.KSDS,DISP=SHR
//INVSTOCK DD DSN=CBANK.PROD.INVSTOCK.KSDS,DISP=SHR
//CMPMAST  DD DSN=CBANK.PROD.CMPMAST.KSDS,DISP=SHR
//MFSCHEME DD DSN=CBANK.PROD.MFSCHEME.KSDS,DISP=SHR
//MFHOLD   DD DSN=CBANK.PROD.MFHOLD.KSDS,DISP=SHR
//MFSIP    DD DSN=CBANK.PROD.MFSIP.KSDS,DISP=SHR
//BRMAST   DD DSN=CBANK.PROD.BRMAST.KSDS,DISP=SHR
//TRANLOG  DD DSN=CBANK.PROD.TRANLOG,DISP=MOD
//AUDITLOG DD DSN=CBANK.PROD.AUDITLOG,DISP=MOD
//GLJRNL   DD DSN=CBANK.PROD.GLJRNL,DISP=MOD
//CCTXN    DD DSN=CBANK.PROD.CCTXN,DISP=MOD
//COLLLOG  DD DSN=CBANK.PROD.COLLLOG,DISP=MOD
//FXLOG    DD DSN=CBANK.PROD.FXLOG,DISP=MOD
//STMTREQ  DD DSN=CBANK.PROD.STMTREQ,DISP=MOD
//INVLOG   DD DSN=CBANK.PROD.INVLOG,DISP=MOD
//MFTXN    DD DSN=CBANK.PROD.MFTXN,DISP=MOD
//YRENDLOG DD DSN=CBANK.PROD.YRENDLOG,DISP=MOD
//SYSOUT   DD SYSOUT=*
//REPORT   DD SYSOUT=*
//         PEND
