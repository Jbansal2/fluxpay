       IDENTIFICATION DIVISION.
       PROGRAM-ID. TDEPCALC.
      *================================================================*
      * UNIT TESTS FOR DEPCALC - BUILT-IN RATE CARD, VERSIONED CARDS   *
      * BY EFFECTIVE DATE, SENIOR COLUMN, FD AND RD VALUES             *
      *================================================================*
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT RATE-FILE ASSIGN TO 'data/FDRATE.DAT'
               ORGANIZATION IS INDEXED ACCESS MODE IS RANDOM
               RECORD KEY IS FR-KEY FILE STATUS IS WS-FS.
       DATA DIVISION.
       FILE SECTION.
       FD  RATE-FILE.
           COPY FDRTREC.
       WORKING-STORAGE SECTION.
           COPY DEPCPARM.
           COPY UTWS.
       01  WS-FS                       PIC X(02).

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'DEPCALC' TO UT-SUITE

           MOVE 'BUILT-IN: 6 MONTHS 6.50%' TO UT-NAME
           MOVE 6 TO DC-TENURE
           MOVE 'N' TO DC-SENIOR
           MOVE ZERO TO DC-AS-OF-DATE
           PERFORM 8000-RATE
           MOVE 6.50 TO UT-EXPECTED-NUM
           PERFORM UT-ASSERT-NUM
           MOVE 'BUILT-IN: 60 MONTHS 7.25%' TO UT-NAME
           MOVE 60 TO DC-TENURE
           PERFORM 8000-RATE
           MOVE 7.25 TO UT-EXPECTED-NUM
           PERFORM UT-ASSERT-NUM
           MOVE 'BUILT-IN: SENIOR +0.50%' TO UT-NAME
           MOVE 'Y' TO DC-SENIOR
           PERFORM 8000-RATE
           MOVE 7.75 TO UT-EXPECTED-NUM
           PERFORM UT-ASSERT-NUM
           MOVE 'BUILT-IN: EFFECTIVE DATE ZERO' TO UT-NAME
           MOVE ZERO TO UT-EXPECTED-NUM
           MOVE DC-RATE-EFF-DATE TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM
           MOVE 'BUILT-IN: 121 MONTHS -> RC 10' TO UT-NAME
           MOVE 121 TO DC-TENURE
           PERFORM 8000-RATE
           MOVE 10 TO UT-EXPECTED-NUM
           MOVE DC-RC TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           MOVE 'FD VALUE 10,000 @ 7% FOR 12 MONTHS' TO UT-NAME
           MOVE 'FV' TO DC-FUNCTION
           MOVE 10000 TO DC-AMOUNT
           MOVE 7 TO DC-RATE
           MOVE 12 TO DC-MONTHS
           CALL 'DEPCALC' USING DEPC-PARMS
           MOVE 10718.59 TO UT-EXPECTED-NUM
           MOVE DC-RESULT-AMT TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           MOVE 'RD VALUE 1,000 x 12 @ 7%' TO UT-NAME
           MOVE 'RV' TO DC-FUNCTION
           MOVE 1000 TO DC-AMOUNT
           MOVE 12 TO DC-MONTHS DC-COUNT
           CALL 'DEPCALC' USING DEPC-PARMS
      *    SUM OF 1000 x 1.0175 ** ((12 - I + 1) / 3), I = 1..12
           MOVE 12462.13 TO UT-EXPECTED-NUM
           MOVE DC-RESULT-AMT TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

      *    TWO CARDS: 2020-01-01 (12M 6.00/6.40, 120M 6.50/7.00)
      *               2030-01-01 (24M 7.00/7.75, 120M 7.10/7.80)
           OPEN OUTPUT RATE-FILE
           MOVE 20200101 TO FR-EFF-DATE
           MOVE 12 TO FR-MAX-MONTHS
           MOVE 6.00 TO FR-GEN-RATE
           MOVE 6.40 TO FR-SNR-RATE
           WRITE FDRT-RECORD
           MOVE 120 TO FR-MAX-MONTHS
           MOVE 6.50 TO FR-GEN-RATE
           MOVE 7.00 TO FR-SNR-RATE
           WRITE FDRT-RECORD
           MOVE 20300101 TO FR-EFF-DATE
           MOVE 24 TO FR-MAX-MONTHS
           MOVE 7.00 TO FR-GEN-RATE
           MOVE 7.75 TO FR-SNR-RATE
           WRITE FDRT-RECORD
           MOVE 60 TO FR-MAX-MONTHS
           MOVE 7.10 TO FR-GEN-RATE
           MOVE 7.80 TO FR-SNR-RATE
           WRITE FDRT-RECORD
           CLOSE RATE-FILE

           MOVE 'CARD 2020: 12 MONTHS GENERAL 6.00%' TO UT-NAME
           MOVE 12 TO DC-TENURE
           MOVE 'N' TO DC-SENIOR
           MOVE 20250615 TO DC-AS-OF-DATE
           PERFORM 8000-RATE
           MOVE 6.00 TO UT-EXPECTED-NUM
           PERFORM UT-ASSERT-NUM
           MOVE 'CARD 2020: EFFECTIVE DATE RETURNED' TO UT-NAME
           MOVE 20200101 TO UT-EXPECTED-NUM
           MOVE DC-RATE-EFF-DATE TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM
           MOVE 'CARD 2020: 13 MONTHS FALLS IN 120 SLAB' TO UT-NAME
           MOVE 13 TO DC-TENURE
           PERFORM 8000-RATE
           MOVE 6.50 TO UT-EXPECTED-NUM
           PERFORM UT-ASSERT-NUM
           MOVE 'CARD 2020: SENIOR COLUMN, NOT +0.50' TO UT-NAME
           MOVE 'Y' TO DC-SENIOR
           PERFORM 8000-RATE
           MOVE 7.00 TO UT-EXPECTED-NUM
           PERFORM UT-ASSERT-NUM
           MOVE 'CARD 2030 FROM ITS EFFECTIVE DAY' TO UT-NAME
           MOVE 'N' TO DC-SENIOR
           MOVE 20300101 TO DC-AS-OF-DATE
           PERFORM 8000-RATE
           MOVE 7.00 TO UT-EXPECTED-NUM
           PERFORM UT-ASSERT-NUM
           MOVE 'DAY BEFORE STILL ON CARD 2020' TO UT-NAME
           MOVE 20291231 TO DC-AS-OF-DATE
           PERFORM 8000-RATE
           MOVE 6.50 TO UT-EXPECTED-NUM
           PERFORM UT-ASSERT-NUM
           MOVE 'CARD 2030 HAS NO SLAB FOR 72 MONTHS -> RC 10'
             TO UT-NAME
           MOVE 72 TO DC-TENURE
           MOVE 20310101 TO DC-AS-OF-DATE
           PERFORM 8000-RATE
           MOVE 10 TO UT-EXPECTED-NUM
           MOVE DC-RC TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM
           MOVE 'BEFORE ANY CARD: BUILT-IN CARD' TO UT-NAME
           MOVE 12 TO DC-TENURE
           MOVE 20190101 TO DC-AS-OF-DATE
           PERFORM 8000-RATE
           MOVE 7.00 TO UT-EXPECTED-NUM
           PERFORM UT-ASSERT-NUM

           PERFORM UT-FINISH
           STOP RUN.

       8000-RATE.
           MOVE 'RT' TO DC-FUNCTION
           CALL 'DEPCALC' USING DEPC-PARMS
           MOVE DC-RESULT-RATE TO UT-ACTUAL-NUM.

           COPY UTPROC.
