       IDENTIFICATION DIVISION.
       PROGRAM-ID. TMFUTIL.
      *================================================================*
      * UNIT TESTS FOR MFUTIL - UNITS AT NAV, MINIMUM, EXIT LOAD,      *
      * COST PRO RATA, INSURANCE PREMIUM AND COMMISSION                *
      *================================================================*
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT ACCT-FILE ASSIGN TO 'data/ACCTMAST.DAT'
               ORGANIZATION IS INDEXED ACCESS MODE IS RANDOM
               RECORD KEY IS ACCT-NO FILE STATUS IS UT-ACCT-FS.
           SELECT MFS-FILE ASSIGN TO 'data/MFSCHEME.DAT'
               ORGANIZATION IS INDEXED ACCESS MODE IS RANDOM
               RECORD KEY IS MS-CODE FILE STATUS IS WS-FS.
           SELECT MFH-FILE ASSIGN TO 'data/MFHOLD.DAT'
               ORGANIZATION IS INDEXED ACCESS MODE IS RANDOM
               RECORD KEY IS MH-KEY FILE STATUS IS WS-FS.
       DATA DIVISION.
       FILE SECTION.
       FD  ACCT-FILE.
           COPY ACCTREC.
       FD  MFS-FILE.
           COPY MFSREC.
       FD  MFH-FILE.
           COPY MFHREC.
       WORKING-STORAGE SECTION.
           COPY MFUPARM.
           COPY UTWS.
           COPY UTSEEDW.
       01  WS-FS                       PIC X(02).

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'MFUTIL' TO UT-SUITE
           MOVE 1000000001 TO UT-SEED-NO
           MOVE 'S' TO UT-SEED-TYPE
           MOVE 'A' TO UT-SEED-STATUS
           MOVE 50000 TO UT-SEED-BALANCE
           MOVE 1000 TO UT-SEED-MIN
           MOVE ZERO TO UT-SEED-OD
           MOVE 'DEL001' TO UT-SEED-BRANCH
           PERFORM UT-SEED-ACCOUNT
           OPEN OUTPUT MFS-FILE
           INITIALIZE MFS-RECORD
           MOVE 'FUND01' TO MS-CODE
           MOVE 'M' TO MS-TYPE
           MOVE 'A' TO MS-STATUS
           MOVE 33.3333 TO MS-NAV
           MOVE 1000 TO MS-MIN-AMT
           MOVE 1 TO MS-EXIT-LOAD-PCT
           MOVE 365 TO MS-LOAD-DAYS
           WRITE MFS-RECORD
           INITIALIZE MFS-RECORD
           MOVE 'LIFE01' TO MS-CODE
           MOVE 'I' TO MS-TYPE
           MOVE 'A' TO MS-STATUS
           MOVE 20 TO MS-COMM-PCT
           WRITE MFS-RECORD
           CLOSE MFS-FILE

           MOVE 'BELOW MINIMUM -> RC 20' TO UT-NAME
           PERFORM 8000-BUY-SETUP
           MOVE 999 TO MU-AMOUNT
           CALL 'MFUTIL' USING MFU-PARMS
           MOVE 20 TO UT-EXPECTED-NUM
           MOVE MU-RC TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           MOVE 'UNITS = AMOUNT / NAV, 3 DECIMALS TRUNCATED' TO UT-NAME
           PERFORM 8000-BUY-SETUP
           MOVE 10000 TO MU-AMOUNT
           CALL 'MFUTIL' USING MFU-PARMS
           MOVE 300.000 TO UT-EXPECTED-NUM
           MOVE MU-UNITS TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           MOVE 'ACCOUNT DEBITED BY THE AMOUNT' TO UT-NAME
           PERFORM UT-READ-ACCOUNT
           MOVE 40000 TO UT-EXPECTED-NUM
           MOVE ACCT-BALANCE TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           MOVE 'NOT ENOUGH MONEY -> RC 30' TO UT-NAME
           PERFORM 8000-BUY-SETUP
           MOVE 45000 TO MU-AMOUNT
           CALL 'MFUTIL' USING MFU-PARMS
           MOVE 30 TO UT-EXPECTED-NUM
           MOVE MU-RC TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           MOVE 'REDEEM 150 UNITS: 1% EXIT LOAD' TO UT-NAME
           INITIALIZE MFU-PARMS
           SET MU-REDEEM TO TRUE
           MOVE 1000000001 TO MU-ACCT-NO
           MOVE 'FUND01' TO MU-CODE
           MOVE 150 TO MU-UNITS
           CALL 'MFUTIL' USING MFU-PARMS
           MOVE 50.00 TO UT-EXPECTED-NUM
           MOVE MU-LOAD TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM
           MOVE 'NET = 150 x 33.3333 - LOAD' TO UT-NAME
           MOVE 4950.00 TO UT-EXPECTED-NUM
           MOVE MU-NET TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           MOVE 'COST REDUCED PRO RATA TO 5,000' TO UT-NAME
           OPEN INPUT MFH-FILE
           MOVE 1000000001 TO MH-ACCT-NO
           MOVE 'FUND01' TO MH-CODE
           READ MFH-FILE
           CLOSE MFH-FILE
           MOVE 5000 TO UT-EXPECTED-NUM
           MOVE MH-COST TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           MOVE 'MORE UNITS THAN HELD -> RC 40' TO UT-NAME
           INITIALIZE MFU-PARMS
           SET MU-REDEEM TO TRUE
           MOVE 1000000001 TO MU-ACCT-NO
           MOVE 'FUND01' TO MU-CODE
           MOVE 151 TO MU-UNITS
           CALL 'MFUTIL' USING MFU-PARMS
           MOVE 40 TO UT-EXPECTED-NUM
           MOVE MU-RC TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           MOVE 'REDEEM ALL CLOSES THE HOLDING' TO UT-NAME
           MOVE ZERO TO MU-UNITS
           CALL 'MFUTIL' USING MFU-PARMS
           OPEN INPUT MFH-FILE
           MOVE 1000000001 TO MH-ACCT-NO
           MOVE 'FUND01' TO MH-CODE
           READ MFH-FILE
           CLOSE MFH-FILE
           MOVE 'C' TO UT-EXPECTED-STR
           MOVE MH-STATUS TO UT-ACTUAL-STR
           PERFORM UT-ASSERT-STR

           MOVE 'PREMIUM WITHOUT A POLICY -> RC 40' TO UT-NAME
           INITIALIZE MFU-PARMS
           SET MU-PREMIUM TO TRUE
           MOVE 1000000001 TO MU-ACCT-NO
           MOVE 'LIFE01' TO MU-CODE
           CALL 'MFUTIL' USING MFU-PARMS
           MOVE 40 TO UT-EXPECTED-NUM
           MOVE MU-RC TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           OPEN I-O MFH-FILE
           INITIALIZE MFH-RECORD
           MOVE 1000000001 TO MH-ACCT-NO
           MOVE 'LIFE01' TO MH-CODE
           MOVE 'A' TO MH-STATUS
           MOVE 'LI0001' TO MH-POLICY-NO
           MOVE 2500 TO MH-PREMIUM
           MOVE 'Q' TO MH-FREQUENCY
           MOVE 20260115 TO MH-NEXT-DUE
           WRITE MFH-RECORD
           CLOSE MFH-FILE
           MOVE 'PREMIUM: 20% COMMISSION' TO UT-NAME
           CALL 'MFUTIL' USING MFU-PARMS
           MOVE 500 TO UT-EXPECTED-NUM
           MOVE MU-COMMISSION TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM
           MOVE 'QUARTERLY: NEXT DUE MOVES 3 MONTHS' TO UT-NAME
           OPEN INPUT MFH-FILE
           MOVE 1000000001 TO MH-ACCT-NO
           MOVE 'LIFE01' TO MH-CODE
           READ MFH-FILE
           CLOSE MFH-FILE
           MOVE 20260415 TO UT-EXPECTED-NUM
           MOVE MH-NEXT-DUE TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           PERFORM UT-FINISH
           STOP RUN.

       8000-BUY-SETUP.
           INITIALIZE MFU-PARMS
           SET MU-BUY TO TRUE
           MOVE 1000000001 TO MU-ACCT-NO
           MOVE 'FUND01' TO MU-CODE
           MOVE 'P' TO MU-SOURCE.

           COPY UTSEEDP.
           COPY UTPROC.
