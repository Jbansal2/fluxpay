       IDENTIFICATION DIVISION.
       PROGRAM-ID. TDATEUTL.
      *================================================================*
      * UNIT TESTS FOR DATEUTIL                                        *
      *================================================================*
       DATA DIVISION.
       WORKING-STORAGE SECTION.
           COPY DATEPARM.
           COPY UTWS.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'DATEUTIL' TO UT-SUITE

           MOVE 'ADD 1 MONTH CLAMPS 31-JAN TO 28-FEB' TO UT-NAME
           SET DU-ADD-MONTHS TO TRUE
           MOVE 20270131 TO DU-DATE-1
           MOVE 1 TO DU-NUMBER
           PERFORM 1000-RESULT-DATE

           MOVE 'ADD 1 MONTH IN A LEAP YEAR GIVES 29-FEB' TO UT-NAME
           MOVE 20280131 TO DU-DATE-1
           PERFORM 1000-RESULT-DATE

           MOVE 'ADD -3 MONTHS CROSSES THE YEAR BACKWARDS' TO UT-NAME
           MOVE 20270115 TO DU-DATE-1
           MOVE -3 TO DU-NUMBER
           PERFORM 1000-RESULT-DATE

           MOVE 'ADD 12 MONTHS' TO UT-NAME
           MOVE 20261014 TO DU-DATE-1
           MOVE 12 TO DU-NUMBER
           PERFORM 1000-RESULT-DATE

           MOVE 'ADD 30 DAYS ACROSS A MONTH END' TO UT-NAME
           SET DU-ADD-DAYS TO TRUE
           MOVE 20261220 TO DU-DATE-1
           MOVE 30 TO DU-NUMBER
           PERFORM 1000-RESULT-DATE

           MOVE 'DAYS BETWEEN COUNTS THE LEAP DAY' TO UT-NAME
           SET DU-DAYS-BETWEEN TO TRUE
           MOVE 20280101 TO DU-DATE-1
           MOVE 20290101 TO DU-DATE-2
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 366 TO UT-EXPECTED-NUM
           MOVE DU-RESULT-DAYS TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           MOVE 'DAYS BETWEEN IS NEGATIVE WHEN DATES ARE REVERSED'
               TO UT-NAME
           MOVE 20261014 TO DU-DATE-1
           MOVE 20261004 TO DU-DATE-2
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE -10 TO UT-EXPECTED-NUM
           MOVE DU-RESULT-DAYS TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           MOVE '29-FEB OF A NON-LEAP YEAR IS INVALID' TO UT-NAME
           SET DU-VALIDATE TO TRUE
           MOVE 20270229 TO DU-DATE-1
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 10 TO UT-EXPECTED-NUM
           MOVE DU-RC TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           MOVE '29-FEB-2000 IS VALID (DIVISIBLE BY 400)' TO UT-NAME
           MOVE 20000229 TO DU-DATE-1
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 0 TO UT-EXPECTED-NUM
           MOVE DU-RC TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           MOVE '29-FEB-2100 IS INVALID (CENTURY RULE)' TO UT-NAME
           MOVE 21000229 TO DU-DATE-1
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 10 TO UT-EXPECTED-NUM
           MOVE DU-RC TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           MOVE 'UNKNOWN FUNCTION IS REJECTED' TO UT-NAME
           MOVE 'ZZ' TO DU-FUNCTION
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 20 TO UT-EXPECTED-NUM
           MOVE DU-RC TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM

           PERFORM UT-FINISH
           STOP RUN.

      *    EXPECTED RESULT IS PASSED IN BY EACH CASE BELOW
       1000-RESULT-DATE.
           CALL 'DATEUTIL' USING DATE-PARMS
           EVALUATE UT-NAME
               WHEN 'ADD 1 MONTH CLAMPS 31-JAN TO 28-FEB'
                   MOVE 20270228 TO UT-EXPECTED-NUM
               WHEN 'ADD 1 MONTH IN A LEAP YEAR GIVES 29-FEB'
                   MOVE 20280229 TO UT-EXPECTED-NUM
               WHEN 'ADD -3 MONTHS CROSSES THE YEAR BACKWARDS'
                   MOVE 20261015 TO UT-EXPECTED-NUM
               WHEN 'ADD 12 MONTHS'
                   MOVE 20271014 TO UT-EXPECTED-NUM
               WHEN 'ADD 30 DAYS ACROSS A MONTH END'
                   MOVE 20270119 TO UT-EXPECTED-NUM
           END-EVALUATE
           MOVE DU-RESULT-DATE TO UT-ACTUAL-NUM
           PERFORM UT-ASSERT-NUM.

           COPY UTPROC.
